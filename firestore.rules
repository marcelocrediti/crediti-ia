rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.uid == 'LuvNA4bYAmQRkFTAHUTDMpsD1ZF2'
        && request.auth.token.email == 'marcelinoteixeira.santos@gmail.com';
    }
    match /simulacoes/{id} {
      allow read, write: if admin();
      match /documentos/{documento} {
        allow read, write: if admin();
      }
    }
    match /contadoresCCB/{id} {
      allow read, write: if admin();
    }
    match /assinaturasCDC/{token} {
      allow read, write: if admin();
      allow get: if token.matches('^[a-f0-9]{64}$')
        && resource.data.expiraEm > request.time
        && resource.data.aceite == null;
      allow update: if token.matches('^[a-f0-9]{64}$')
        && resource.data.expiraEm > request.time
        && resource.data.aceite == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aceite','assinadoEm'])
        && request.resource.data.assinadoEm == request.time
        && request.resource.data.aceite is map
        && request.resource.data.aceite.keys().hasOnly(['timestamp','foto','geo','endereco'])
        && request.resource.data.aceite.timestamp is int
        && request.resource.data.aceite.timestamp > request.time.toMillis() - 300000
        && request.resource.data.aceite.timestamp < request.time.toMillis() + 300000
        && request.resource.data.aceite.foto is string
        && request.resource.data.aceite.foto.size() < 750000
        && request.resource.data.aceite.foto.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && (request.resource.data.aceite.endereco == null ||
          (request.resource.data.aceite.endereco is string && request.resource.data.aceite.endereco.size() < 2000))
        && (request.resource.data.aceite.geo == null ||
          (request.resource.data.aceite.geo is map
          && request.resource.data.aceite.geo.keys().hasOnly(['lat','lng'])
          && request.resource.data.aceite.geo.lat is number
          && request.resource.data.aceite.geo.lng is number
          && request.resource.data.aceite.geo.lat >= -90 && request.resource.data.aceite.geo.lat <= 90
          && request.resource.data.aceite.geo.lng >= -180 && request.resource.data.aceite.geo.lng <= 180));
    }
    // Only a random, unguessable link can access its own intake for 30 minutes.
    match /preanalisesCDC/{token} {
      function active(d) {
        return token.matches('^[a-f0-9]{64}$') && d.estado == 'aberto'
          && d.criadoEm <= request.time
          && request.time < d.criadoEm + duration.value(30, 'm');
      }
      function validResponse(r) {
        return r is map
          && r.keys().hasAll(['cpf','telefone','email','endereco','profissao','renda','despesas','outrasParcelas','restricao','cpfNaIdentidade','consentimento','arquivos'])
          && r.keys().hasOnly(['cpf','telefone','email','endereco','profissao','renda','despesas','outrasParcelas','restricao','cpfNaIdentidade','consentimento','arquivos','residenciaTitular','residenciaJustificativa'])
          && ((!r.keys().hasAny(['residenciaTitular','residenciaJustificativa'])) ||
            (r.keys().hasAll(['residenciaTitular','residenciaJustificativa'])
            && r.residenciaTitular in ['proprio','terceiro']
            && r.residenciaJustificativa is string && r.residenciaJustificativa.size() <= 600
            && (r.residenciaTitular == 'proprio' || r.residenciaJustificativa.size() > 0)))
          && r.cpf is string && r.cpf.matches('^[0-9]{11}$')
          && r.telefone is string && r.telefone.matches('^[0-9]{10,13}$')
          && r.email is string && r.email.size() <= 160
          && r.endereco is string && r.endereco.size() > 0 && r.endereco.size() <= 300
          && r.profissao is string && r.profissao.size() > 0 && r.profissao.size() <= 160
          && r.renda is number && r.renda > 0 && r.renda <= 10000000
          && r.despesas is number && r.despesas >= 0 && r.despesas <= 10000000
          && r.outrasParcelas is number && r.outrasParcelas >= 0 && r.outrasParcelas <= 10000000
          && r.restricao in ['sim','nao','nao_sei']
          && r.cpfNaIdentidade is bool && r.consentimento == true
          && r.arquivos is list && r.arquivos.size() >= 3 && r.arquivos.size() <= 20
          && r.arquivos.hasOnly(['rgFrente','rgFrente__2','rgFrente__3','rgFrente__4','rgFrente__5','cpfFrente','cpfFrente__2','cpfFrente__3','cpfFrente__4','cpfFrente__5','comprovanteResidencia','comprovanteResidencia__2','comprovanteResidencia__3','comprovanteResidencia__4','comprovanteResidencia__5','comprovanteRenda','comprovanteRenda__2','comprovanteRenda__3','comprovanteRenda__4','comprovanteRenda__5'])
          && r.arquivos.hasAll(['rgFrente','comprovanteResidencia','comprovanteRenda'])
          && (r.cpfNaIdentidade || r.arquivos.hasAll(['cpfFrente']));
      }
      allow read, write: if admin();
      allow get: if active(resource.data);
      allow update: if active(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','resposta','enviadoEm'])
        && request.resource.data.estado == 'enviado'
        && request.resource.data.enviadoEm == request.time
        && validResponse(request.resource.data.resposta);
      match /documentos/{slot} {
        allow read, write: if admin();
        // Documents are write-only for the link holder. No public listing/downloads.
        allow create, update: if active(get(/databases/$(database)/documents/preanalisesCDC/$(token)).data)
          && slot.matches('^(rgFrente|cpfFrente|comprovanteResidencia|comprovanteRenda)(__[2-5])?$')
          && request.resource.data.keys().hasOnly(['nome','tipo','dataUrl'])
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 160
          && request.resource.data.tipo in ['application/pdf','image/jpeg']
          && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() <= 950000
          && ((request.resource.data.tipo == 'application/pdf' && request.resource.data.dataUrl.matches('^data:application/pdf;base64,JVBER[A-Za-z0-9+/=]+$'))
            || (request.resource.data.tipo == 'image/jpeg' && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,/9j/[A-Za-z0-9+/=]+$')));
      }
    }
    // SHA-256(CPF + random 128-bit code). No lists or public writes.
    match /consultasCDC/{key} {
      allow read, write: if admin();
      allow get: if key.matches('^[a-f0-9]{64}$')
        && resource.data.keys().hasOnly(['status','motivos','atualizadoEm','expiraEm'])
        && (!resource.data.keys().hasAny(['motivos']) ||
          (resource.data.motivos is list && resource.data.motivos.size() <= 20))
        && resource.data.status in ['Em análise','Pendente','Pré-aprovada','Recusada','Contratada']
        && resource.data.expiraEm > request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


